```gitignore
# Environment variables
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
ENV/

# Python cache and testing
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Local databases
*.db
*.sqlite
*.sqlite3
!database/schema.sql

# Uploads and temporary exports
uploads/
reports/
*.csv
*.txt
!requirements.txt

# Streamlit config and cache
.streamlit/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
```

